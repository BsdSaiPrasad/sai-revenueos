# P1.6 credentials are entered through configure_live_auth.py and stored only
# under ignored generated-data/. Never add Salesforce or HubSpot tokens here.
SAI_REVENUEOS_ENV=development

# P1.7 PATs are entered through configure_snowflake_auth.py and stored only in
# ignored generated-data/p17-snowflake/credentials.json with mode 600.
# Never place a Snowflake token, password, or real account identifier here.
SNOWFLAKE_CREDENTIALS_FILE=generated-data/p17-snowflake/credentials.json
