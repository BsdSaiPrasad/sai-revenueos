{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/BsdSaiPrasad/sai-revenueos/identity-resolution-output.v1.json",
  "title": "SAI RevenueOS Approved Identity Mapping v1",
  "description": "Stable P1.8 output boundary for future P1.9 canonical models. Only active, human-approved P1.2 crosswalks qualify.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_name",
    "contract_version",
    "generated_at",
    "mappings"
  ],
  "properties": {
    "contract_name": {
      "const": "identity-resolution-output"
    },
    "contract_version": {
      "const": "1.0.0"
    },
    "generated_at": {
      "type": "string",
      "minLength": 1
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "external_identity_crosswalk_id",
          "source_record_id",
          "canonical_entity_type",
          "canonical_entity_id",
          "mapping_status",
          "mapping_method",
          "confidence",
          "valid_from",
          "valid_to",
          "reviewed_by",
          "reviewed_at"
        ],
        "properties": {
          "external_identity_crosswalk_id": {"type": "string", "minLength": 1},
          "source_record_id": {"type": "string", "minLength": 1},
          "canonical_entity_type": {"enum": ["Account", "Person"]},
          "canonical_entity_id": {"type": "string", "minLength": 1},
          "mapping_status": {"const": "active"},
          "mapping_method": {"type": "string", "minLength": 1},
          "confidence": {"type": "number", "minimum": 0, "maximum": 1},
          "valid_from": {"type": "string", "minLength": 1},
          "valid_to": {"type": ["string", "null"]},
          "reviewed_by": {"type": "string", "minLength": 1},
          "reviewed_at": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
